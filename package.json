{
  "name": "logo-add-tool",
  "version": "0.1.4",
  "private": false,
  "description": "用于把 Logo 添加到整份 PowerPoint 的侧边栏插件。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Erica1018/logo-add-tool.git"
  },
  "bugs": {
    "url": "https://github.com/Erica1018/logo-add-tool/issues"
  },
  "homepage": "https://github.com/Erica1018/logo-add-tool#readme",
  "scripts": {
    "dev": "vite --host localhost --port 3001",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 3001",
    "serve:local": "node server/local-server.mjs",
    "render:manifest": "node tools/render-manifest.mjs",
    "package:mac": "node tools/package-mac-release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/office-js": "^1.0.477",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "office-addin-dev-certs": "^2.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
